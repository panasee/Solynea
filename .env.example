# Never put a real key in this example or commit a populated .env.
# Prefer setting PRIVATE_KEY in the current process; never share it in chat.
PRIVATE_KEY=
OWNER_ADDRESS=

# Set these for your chosen EVM network.
DEPLOY_CHAIN_ID=
RPC_URL=
# Must match the target network and the settings used for verification.
FOUNDRY_EVM_VERSION=cancun
ETHERSCAN_API_KEY=

# Optional deployment overrides; defaults live in src/TokenConfig.sol.
TOKEN_NAME=Solynea
TOKEN_SYMBOL=SLN
TOKEN_DECIMALS=18
# RAW smallest units, not whole tokens: 100 SLN = 100000000000000000000.
INITIAL_SUPPLY=0
